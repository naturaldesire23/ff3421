                        local selected = {}
                        for value in string.gmatch(CurrentOption.Text, "([^,]+)") do
                            local trimmedValue = value:match("^%s*(.-)%s*$")
                            if trimmedValue ~= "" then table.insert(selected, trimmedValue) end
                        end
                        local optionName = (typeof(option) == 'string' and option) or (option and option.Name) or ''
                        local idx = table.find(selected, optionName)
                        if idx then table.remove(selected, idx) else table.insert(selected, optionName) end
                        CurrentOption.Text = table.concat(selected, ", ")
                        Library._config._flags[s.flag] = convertStringToTable(CurrentOption.Text)
                    else
                        CurrentOption.Text = (typeof(option) == "string" and option) or (option and option.Name) or ''
                        Library._config._flags[s.flag] = option
                    end
                    for _, object in OptionsFrame:GetChildren() do
                        if object.Name == "Option" then
                            object.TextTransparency = (object.Text == CurrentOption.Text) and 0.2 or 0.6
                        end
