                for _, offset in { Vector2.zero, inset, -inset } do
                    local point = location + offset
                    if point.X >= top_left.X and point.X <= bottom_right.X
                       and point.Y >= top_left.Y and point.Y <= bottom_right.Y then
                        Pointer_Offset = offset
                        return
                    end
                end
