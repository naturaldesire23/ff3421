local function apply_search_filter(query)
    query = (query or ''):lower():gsub('^%s+', ''):gsub('%s+$', '')
    local any_per_tab = {}

    for _, entry in ipairs(Library._searchable_modules) do
        local title = (entry.title or ''):lower()
        local desc  = (entry.desc or ''):lower()
        local match = (query == '') or title:find(query, 1, true) or desc:find(query, 1, true)
        entry.module.Visible = match
        if match then any_per_tab[entry.tab_id] = true end
    end

    -- hide sections with no visible modules
    local Sections = Library._refs.Sections
    if Sections then
        for _, section in ipairs(Sections:GetChildren()) do
            if section.Name == 'LeftSection' or section.Name == 'RightSection' then
                local any = false
                for _, mod in ipairs(section:GetChildren()) do
                    if mod.Name == 'Module' and mod.Visible then any = true break end
                end
                section.Visible = any
            end
        end
    end
end

