                    }):Play()
                    TweenService:Create(Dropdown, TweenInfo.new(0.28, Enum.EasingStyle.Quint), {
                        Size = UDim2.fromOffset(210, 45 + extra)
                    }):Play()
                    TweenService:Create(Box, TweenInfo.new(0.28, Enum.EasingStyle.Quint), {
                        Size = UDim2.fromOffset(210, 28 + extra)
                    }):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.28, Enum.EasingStyle.Quint), {
                        Rotation = self._state and 180 or 0
                    }):Play()
                end

                function DropdownManager:refresh(new_options)
                    for _, child in ipairs(OptionsFrame:GetChildren()) do
                        if child.Name == 'Option' then child:Destroy() end
                    end
                    self._size = 8
                    for index, value in new_options do
                        local Option = Instance.new('TextButton')
