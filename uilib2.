local function resolve_image(source, folder)
    folder = folder or (NAMESPACE..'/Icons')
    if source == nil or source == '' then return '' end
    if source:match('^%d+$')      then return 'rbxassetid://'..source end
    if source:match('^rbx%a+://') then return source end
    local Custom_Asset = getcustomasset or getsynasset
    if not Custom_Asset then return source end
    if not source:match('^https?://') then
        return (isfile(source) and Custom_Asset(source)) or source
    end
    if not isfolder(folder) then makefolder(folder) end
    local ext  = source:match('%.(%a%a%a%a?)[%?#]')
              or source:match('%.(%a%a%a%a?)$')
              or 'png'
    local name = source:gsub('%W',''):sub(-48)..'.'..ext
    local path = folder..'/'..name
    if not isfile(path) then
        local ok, body = pcall(game.HttpGet, game, source, true)
        if not ok or not body then return '' end
        writefile(path, body)
    end
    return Custom_Asset(path)
end

