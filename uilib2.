    function self:apply_container_opacity(value)
        -- value 0..100 from slider; 0 = solid-ish, 100 = fully transparent
        Library._container_opacity = value
        Container.BackgroundTransparency = 0.18 + (value / 100) * 0.82
    end

    function self:load()
        self:get_device()

        local function get_container_size()
            local viewport = Workspace.CurrentCamera.ViewportSize
            local max_w = viewport.X - 40
            local max_h = viewport.Y - 40
            local want_w, want_h = 752, 479
            local w = math.min(want_w, max_w)
            local h = math.min(want_h, max_h)
            return w, h
        end

        local function apply_viewport_scale()
            local viewport = Workspace.CurrentCamera.ViewportSize
            local max_w = viewport.X - 40
            local max_h = viewport.Y - 40
            local scale_x = math.min(1, max_w / 752)
            local scale_y = math.min(1, max_h / 479)
            local scale = math.clamp(math.min(scale_x, scale_y), 0.55, 1)
            UIScale.Scale = scale
            if ShadowScale then ShadowScale.Scale = scale end
            Library._ui_scale = scale
            Library._viewport_size = Vector2.new(max_w / scale, max_h / scale)
        end

        apply_viewport_scale()

        Connections['ui_scale'] = Workspace.CurrentCamera:GetPropertyChangedSignal('ViewportSize'):Connect(function()
            apply_viewport_scale()
            local w, h = get_container_size()
            local scale = Library._ui_scale
            Container.Size = UDim2.fromOffset(w / scale, h / scale)

            for _, section in Sections:GetChildren() do
                if section.Name == 'LeftSection' or section.Name == 'RightSection' then
                    section.Size = UDim2.new(0, 243, 0, (h / scale) - 124)
                end
            end
        end)

        ShadowHolder.Visible = true

        local w, h = get_container_size()
        local scale = Library._ui_scale
        Container.Size = UDim2.fromOffset(0, 0)
        TweenService:Create(Container, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(w / scale, h / scale)
        }):Play()

        Library._full_size = UDim2.fromOffset(w / scale, h / scale)
    end

    function self:update_tabs(tab)
        for index, object in Tabs:GetChildren() do
            if object.Name ~= 'Tab' then continue end

            if object == tab then
                if object.BackgroundTransparency ~= 0.5 then
                    TweenService:Create(object, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0.5
                    }):Play()
                    TweenService:Create(object.TextLabel, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        TextTransparency = 0,
                        TextColor3 = Theme.Text
                    }):Play()
                    TweenService:Create(object.TextLabel.UIGradient, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        Offset = Vector2.new(1, 0)
                    }):Play()
                    TweenService:Create(object.Icon, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        ImageColor3 = object.Icon:GetAttribute('ActiveColor') or Theme.Text
                    }):Play()
                end
                continue
            end

            if object.BackgroundTransparency ~= 1 then
                TweenService:Create(object, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(object.TextLabel, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    TextTransparency = 0,
                    TextColor3 = Theme.TextDim
                }):Play()
                TweenService:Create(object.TextLabel.UIGradient, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    Offset = Vector2.new(0, 0)
                }):Play()
                TweenService:Create(object.Icon, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    ImageColor3 = object.Icon:GetAttribute('IdleColor') or Theme.TextDim
                }):Play()
            end
        end
    end

