function Library.SetBackgroundPresets(presets)
    Library._backgroundPresets = presets or {}
    local opts = { 'None' }
    for name, _ in pairs(Library._backgroundPresets) do
        table.insert(opts, name)
    end
    table.sort(opts, function(a, b)
        if a == 'None' then return true end
        if b == 'None' then return false end
        return a < b
    end)
    Library._presetOptions = opts
end

function Library.SaveBackgroundPreset(name, source)
    if not name or name == '' then return false end
    Library._backgroundPresets[name] = source
    Library.SetBackgroundPresets(Library._backgroundPresets)
    local path = NAMESPACE..'/BgPresets/'..name..'.json'
    pcall(function()
        writefile(path, HttpService:JSONEncode({ name = name, source = source }))
    end)
    return true
end

function Library.DeleteBackgroundPreset(name)
    if not name or name == '' then return false end
    Library._backgroundPresets[name] = nil
    Library.SetBackgroundPresets(Library._backgroundPresets)
    local path = NAMESPACE..'/BgPresets/'..name..'.json'
    pcall(function()
        if isfile(path) then delfile(path) end
    end)
    return true
end

function Library.LoadBackgroundPresets()
    if not isfolder(NAMESPACE..'/BgPresets') then makefolder(NAMESPACE..'/BgPresets') end
    if not listfiles then return end
    local files = listfiles(NAMESPACE..'/BgPresets')
    for _, file in ipairs(files) do
        if file:match('%.json$') then
            local ok, data = pcall(function()
                return HttpService:JSONDecode(readfile(file))
            end)
            if ok and data and data.name and data.source then
                Library._backgroundPresets[data.name] = data.source
            end
        end
    end
    Library.SetBackgroundPresets(Library._backgroundPresets)
end

function Library.new(opts)
    opts = opts or {}
    local name = opts.name or "Xinve"
    local logo = opts.logo or "rbxassetid://119051552929078"

    if opts.namespace then
        NAMESPACE = tostring(opts.namespace)
        ensureFolders()
    end

    Library._clientName = name
    Library._clientLogo = logo
    Library._resolvedLogo = resolve_image(logo, NAMESPACE..'/Icons')
    Library._config = Config:load(game.GameId, { _flags = {}, _keybinds = {} })
    Library.LoadBackgroundPresets()

    Library._moduleLive   = {}
    Library._checkboxLive = {}
    Library._liveUpdaters = {}
    Library._searchable_modules = {}

    local self = setmetatable({ _tab = 0 }, Library)
    self:create_ui()
    return self
end

