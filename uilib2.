local RunService  = game:GetService('RunService')

local GP = {}

local CACHE_DIR = NAMESPACE..'/Backgrounds'
if not isfolder(NAMESPACE) then makefolder(NAMESPACE) end
if not isfolder(CACHE_DIR) then makefolder(CACHE_DIR) end

local CustomAsset = getcustomasset or getsynasset

-- ═══════════════════════════════════════════════════════════════
--  CRC32 (needed for PNG chunks)
-- ═══════════════════════════════════════════════════════════════
local CRC_TABLE = {}
do
    for i = 0, 255 do
        local c = i
        for _ = 1, 8 do
            if c % 2 == 1 then
                c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1))
            else
                c = bit32.rshift(c, 1)
            end
        end
        CRC_TABLE[i] = c
    end
end

local function crc32(bytes, startIdx, endIdx)
    local crc = 0xFFFFFFFF
    startIdx = startIdx or 1
    endIdx = endIdx or #bytes
    for i = startIdx, endIdx do
        local b = bytes[i] or string.byte(bytes, i)
        crc = bit32.bxor(CRC_TABLE[bit32.band(bit32.bxor(crc, b), 0xFF)], bit32.rshift(crc, 8))
    end
    return bit32.bxor(crc, 0xFFFFFFFF)
end

-- ═══════════════════════════════════════════════════════════════
--  Deflate (uncompressed blocks — valid zlib, just not compressed)
--  Fast + guaranteed correct. Files are bigger, but Roblox reads them.
-- ═══════════════════════════════════════════════════════════════
local function adler32(data)
    local a, b = 1, 0
    local mod = 65521
    for i = 1, #data do
        local byte = string.byte(data, i)
        a = (a + byte) % mod
        b = (b + a) % mod
    end
    return b * 65536 + a
end

local function zlib_store(data)
    local out = {}
    out[#out+1] = string.char(0x78, 0x01)  -- zlib header (no compression, fastest)

    local pos = 1
    local len = #data
    while pos <= len do
        local chunk = math.min(65535, len - pos + 1)
        local final = (pos + chunk - 1 == len) and 1 or 0
        out[#out+1] = string.char(final)
        out[#out+1] = string.char(chunk % 256, math.floor(chunk / 256))
        out[#out+1] = string.char(bit32.bnot(chunk) % 256, math.floor(bit32.bnot(chunk) / 256) % 256)
        out[#out+1] = data:sub(pos, pos + chunk - 1)
        pos = pos + chunk
    end

    local ad = adler32(data)
    out[#out+1] = string.char(
        math.floor(ad / 16777216) % 256,
        math.floor(ad / 65536) % 256,
        math.floor(ad / 256) % 256,
        ad % 256
    )
    return table.concat(out)
end

-- ═══════════════════════════════════════════════════════════════
--  PNG encoder — RGBA, no filter, stored deflate
-- ═══════════════════════════════════════════════════════════════
local function png_chunk(chunk_type, data)
    local len_be = string.char(
        math.floor(#data / 16777216) % 256,
        math.floor(#data / 65536) % 256,
        math.floor(#data / 256) % 256,
        #data % 256
    )
    local crc_input = chunk_type..data
    local c = crc32(crc_input)
    local crc_be = string.char(
        math.floor(c / 16777216) % 256,
        math.floor(c / 65536) % 256,
        math.floor(c / 256) % 256,
        c % 256
    )
    return len_be..crc_input..crc_be
end

-- rgba: string of width*height*4 bytes (R,G,B,A per pixel, row major)
local function encode_png(width, height, rgba)
    local sig = string.char(137, 80, 78, 71, 13, 10, 26, 10)

    local ihdr_data = string.char(
        math.floor(width / 16777216) % 256, math.floor(width / 65536) % 256,
        math.floor(width / 256) % 256, width % 256,
        math.floor(height / 16777216) % 256, math.floor(height / 65536) % 256,
        math.floor(height / 256) % 256, height % 256,
        8,  -- bit depth
        6,  -- color type RGBA
        0, 0, 0
    )

    -- add filter byte (0) at start of each scanline
    local raw = {}
    local row_size = width * 4
    for y = 0, height - 1 do
        raw[#raw+1] = '\0'
        raw[#raw+1] = rgba:sub(y * row_size + 1, (y + 1) * row_size)
    end
    local raw_str = table.concat(raw)

    local idat_data = zlib_store(raw_str)

    return sig
        ..png_chunk('IHDR', ihdr_data)
        ..png_chunk('IDAT', idat_data)
        ..png_chunk('IEND', '')
end

-- ═══════════════════════════════════════════════════════════════
--  GIF decoder
-- ═══════════════════════════════════════════════════════════════

-- LZW dictionary-based decode per GIF spec
local function lzw_decode(min_code_size, data, expected_pixels)
    local clear_code = 1 << min_code_size
    local end_code   = clear_code + 1
    local code_size  = min_code_size + 1
    local dict = {}
    local reset_dict = function()
        dict = {}
        for i = 0, clear_code - 1 do
            dict[i] = string.char(i)
        end
        code_size = min_code_size + 1
    end
    reset_dict()

    local output = {}
    local bit_buf, bit_count = 0, 0
    local pos = 1
    local data_len = #data
    local prev = nil

    while pos <= data_len or bit_count >= code_size do
        while bit_count < code_size and pos <= data_len do
            bit_buf = bit_buf + (string.byte(data, pos) << bit_count)
            bit_count = bit_count + 8
            pos = pos + 1
        end
        if bit_count < code_size then break end

        local code = bit_buf % (1 << code_size)
        bit_buf = bit32.rshift(bit_buf, code_size)
        bit_count = bit_count - code_size

        if code == clear_code then
            reset_dict()
            prev = nil
        elseif code == end_code then
            break
        else
            local entry
            if dict[code] then
                entry = dict[code]
            elseif code == #dict and prev then
                entry = prev..prev:sub(1, 1)
            else
                break
            end
            output[#output+1] = entry
            if prev then
                dict[#dict] = prev..entry:sub(1, 1)
                if #dict >= (1 << code_size) and code_size < 12 then
                    code_size = code_size + 1
                end
            end
            prev = entry
            if #output >= expected_pixels * 2 then break end
        end
    end

    return table.concat(output)
end

-- parse a single GIF, return { width, height, frames = { {rgba=..., delay=..., w=..., h=..., x=..., y=...} }, loop }
function GP.decode_gif(bytes)
    if bytes:sub(1, 6) ~= 'GIF87a' and bytes:sub(1, 6) ~= 'GIF89a' then
        return nil, 'not a gif'
    end

    local pos = 7
    local width, height = string.byte(bytes, pos) + string.byte(bytes, pos+1) * 256,
                          string.byte(bytes, pos+2) + string.byte(bytes, pos+3) * 256
    local packed = string.byte(bytes, pos+4)
    local global_ct_flag = bit32.band(packed, 0x80) ~= 0
    local global_ct_size = 2 ^ (bit32.band(packed, 0x07) + 1)
    local bg_index = string.byte(bytes, pos+5)
    pos = pos + 7

    local global_ct = nil
    if global_ct_flag then
        global_ct = {}
        for i = 0, global_ct_size - 1 do
            global_ct[i] = {
                string.byte(bytes, pos),
                string.byte(bytes, pos+1),
                string.byte(bytes, pos+2),
            }
            pos = pos + 3
        end
    end

    local frames = {}
    local canvas = {} -- current composited canvas RGBA per pixel
    local canvas_r, canvas_g, canvas_b, canvas_a = {}, {}, {}, {}
    for i = 1, width * height do
        canvas_r[i], canvas_g[i], canvas_b[i], canvas_a[i] = 0, 0, 0, 0
    end

    local gce = nil
    local loop_count = 0
    local transparent_index = nil
    local disposal = 0
    local delay = 10
    local local_ct = nil

    while pos <= #bytes do
        local block = string.byte(bytes, pos)
        pos = pos + 1

        if block == 0x3B then break -- trailer
        elseif block == 0x21 then -- extension
            local label = string.byte(bytes, pos); pos = pos + 1
            if label == 0xF9 then -- graphic control
                local size = string.byte(bytes, pos); pos = pos + 1
                local flags = string.byte(bytes, pos)
                disposal = bit32.band(bit32.rshift(flags, 2), 0x07)
                transparent_index = (bit32.band(flags, 0x01) ~= 0) and string.byte(bytes, pos+3) or nil
                delay = string.byte(bytes, pos+1) + string.byte(bytes, pos+2) * 256
                pos = pos + size
                pos = pos + 1 -- terminator
            elseif label == 0xFF then -- application (NETSCAPE loop)
                local size = string.byte(bytes, pos); pos = pos + 1
                local app = bytes:sub(pos, pos + size - 1); pos = pos + size
                if app:sub(1, 8) == 'NETSCAPE' then
                    local sub_size = string.byte(bytes, pos); pos = pos + 1
                    pos = pos + 1 -- sub-block id
                    loop_count = string.byte(bytes, pos) + string.byte(bytes, pos+1) * 256
                    pos = pos + sub_size - 1
                    pos = pos + 1
                else
                    -- skip sub-blocks
                    while pos <= #bytes do
                        local sz = string.byte(bytes, pos); pos = pos + 1
                        if sz == 0 then break end
                        pos = pos + sz
                    end
                end
            else
                -- skip
                while pos <= #bytes do
                    local sz = string.byte(bytes, pos); pos = pos + 1
                    if sz == 0 then break end
                    pos = pos + sz
                end
            end
        elseif block == 0x2C then -- image descriptor
            local ix = string.byte(bytes, pos) + string.byte(bytes, pos+1) * 256
            local iy = string.byte(bytes, pos+2) + string.byte(bytes, pos+3) * 256
            local iw = string.byte(bytes, pos+4) + string.byte(bytes, pos+5) * 256
            local ih = string.byte(bytes, pos+6) + string.byte(bytes, pos+7) * 256
            local ipacked = string.byte(bytes, pos+8)
            pos = pos + 9

            local has_local_ct = bit32.band(ipacked, 0x80) ~= 0
            local interlace = bit32.band(ipacked, 0x40) ~= 0
            local local_size = 2 ^ (bit32.band(ipacked, 0x07) + 1)

            local_ct = nil
            if has_local_ct then
                local_ct = {}
                for i = 0, local_size - 1 do
                    local_ct[i] = {
                        string.byte(bytes, pos),
                        string.byte(bytes, pos+1),
                        string.byte(bytes, pos+2),
                    }
                    pos = pos + 3
                end
            end

            local min_code_size = string.byte(bytes, pos); pos = pos + 1

            -- gather LZW sub-blocks
            local lzw_data = {}
            while pos <= #bytes do
                local sz = string.byte(bytes, pos); pos = pos + 1
                if sz == 0 then break end
                lzw_data[#lzw_data+1] = bytes:sub(pos, pos + sz - 1)
                pos = pos + sz
            end
            lzw_data = table.concat(lzw_data)

            local indices = lzw_decode(min_code_size, lzw_data, iw * ih)

            -- apply disposal from previous frame
            -- disposal is for THIS frame's canvas before drawing
            -- (per spec, disposal applies to the frame being replaced; we save pre-state if needed)

            local pre_r, pre_g, pre_b, pre_a
            if disposal == 3 then
                pre_r, pre_g, pre_b, pre_a = {}, {}, {}, {}
                for i = 1, width * height do
                    pre_r[i], pre_g[i], pre_b[i], pre_a[i] =
                        canvas_r[i], canvas_g[i], canvas_b[i], canvas_a[i]
                end
            end

            local ct = local_ct or global_ct
            local transparent = transparent_index
            local draw_row = function(y)
                for x = 0, iw - 1 do
                    local idx = string.byte(indices, y * iw + x + 1)
                    if idx == nil then break end
                    if idx == transparent then continue end
                    local c = ct[idx]
                    if not c then continue end
                    local px = ix + x + 1
                    local py = iy + y + 1
                    if px >= 1 and px <= width and py >= 1 and py <= height then
                        local ci = (py - 1) * width + px
                        canvas_r[ci], canvas_g[ci], canvas_b[ci], canvas_a[ci] = c[1], c[2], c[3], 255
                    end
                end
            end

            if interlace then
                -- 4-pass interlace
                for _, pass in ipairs({
                    {0, 8}, {4, 8}, {2, 4}, {1, 2}
                }) do
                    local start, step = pass[1], pass[2]
                    for y = start, ih - 1, step do
                        draw_row(y)
                    end
                end
            else
                for y = 0, ih - 1 do
                    draw_row(y)
                end
            end

            -- snapshot current canvas as a frame
            local frame_rgba = {}
            for i = 1, width * height do
                frame_rgba[i] = string.char(
                    canvas_r[i] or 0,
                    canvas_g[i] or 0,
                    canvas_b[i] or 0,
                    canvas_a[i] or 0
                )
            end
            frames[#frames+1] = {
                rgba = table.concat(frame_rgba),
                w = width,
                h = height,
                delay = delay == 0 and 10 or delay,
            }

            -- apply disposal for next frame
            if disposal == 2 then
                -- restore to background (clear this frame's rect)
                for y = 0, ih - 1 do
                    for x = 0, iw - 1 do
                        local px = ix + x + 1
                        local py = iy + y + 1
                        if px >= 1 and px <= width and py >= 1 and py <= height then
                            local ci = (py - 1) * width + px
                            canvas_r[ci], canvas_g[ci], canvas_b[ci], canvas_a[ci] = 0, 0, 0, 0
                        end
                    end
                end
            elseif disposal == 3 then
                if pre_r then
                    canvas_r, canvas_g, canvas_b, canvas_a = pre_r, pre_g, pre_b, pre_a
                end
            end

            transparent_index = nil
            disposal = 0
            delay = 10
        else
            -- unknown block; bail
            break
        end
    end

    return {
        width = width,
        height = height,
        frames = frames,
        loop = loop_count,
    }
end

-- ═══════════════════════════════════════════════════════════════
--  Pack frames into a horizontal sprite sheet
-- ═══════════════════════════════════════════════════════════════
local function pack_sprite_sheet(parsed)
    local w, h = parsed.width, parsed.height
    local n = #parsed.frames
    if n == 0 then return nil end

    -- cap frames to keep sheet < 8192px wide (Roblox limit ~8192)
    local MAX_SHEET = 8192
    local max_cols = math.max(1, math.floor(MAX_SHEET / w))
    local columns = math.min(n, max_cols)
    if columns < n then
        -- subsample frames
        local stride = math.ceil(n / columns)
        local kept = {}
        for i = 1, n, stride do kept[#kept+1] = parsed.frames[i] end
        parsed.frames = kept
        n = #kept
        columns = n
    end

    local rows = 1
    local sheet_w = w * columns
    local sheet_h = h * rows

    local out = {}
    local row_size = sheet_w * 4
    local row_bytes = {}
    for i = 1, sheet_h do
        row_bytes[i] = string.rep('\0', row_size)
    end

    for i, frame in ipairs(parsed.frames) do
        local col = i - 1
        for y = 0, h - 1 do
            local src_start = (y * w * 4) + 1
            local src_end = src_start + w * 4 - 1
            local src = frame.rgba:sub(src_start, src_end)
            local dst_row = y + 1
            local dst_col_start = col * w * 4 + 1
            row_bytes[dst_row] = row_bytes[dst_row]:sub(1, dst_col_start - 1)
                ..src
                ..row_bytes[dst_row]:sub(dst_col_start + w * 4)
        end
    end

    return {
        rgba = table.concat(row_bytes),
        width = sheet_w,
        height = sheet_h,
        columns = columns,
        rows = rows,
        frame_w = w,
        frame_h = h,
        frame_count = n,
    }
end

-- ═══════════════════════════════════════════════════════════════
--  Hash
-- ═══════════════════════════════════════════════════════════════
local function hash_str(s)
    local h = 5381
    for i = 1, #s do
        h = bit32.band(h * 33 + string.byte(s, i), 0xFFFFFFFF)
    end
    return string.format('%08x', h)
end

-- ═══════════════════════════════════════════════════════════════
--  PUBLIC — process a URL or asset id
-- ═══════════════════════════════════════════════════════════════
-- Returns: table  on success
--          nil, err on failure
-- Shape: { asset, frames, columns, rows, frame_size=Vector2, fps }
function GP.process(source)
    if not source or source == '' then return nil, 'empty source' end

    -- Roblox asset id — just pass through (Roblox already animates those)
    if source:match('^%d+$') then
        return { asset = 'rbxassetid://'..source, static = true }
    end
    if source:match('^rbxassetid://') then
        return { asset = source, static = true }
    end

    -- cache lookup
    local key = hash_str(source)
    local png_path = CACHE_DIR..'/'..key..'.png'
    local meta_path = CACHE_DIR..'/'..key..'.meta.json'

    if isfile(png_path) and isfile(meta_path) then
        local ok, meta = pcall(function()
            return HttpService:JSONDecode(readfile(meta_path))
        end)
        if ok and meta then
            return {
                asset = CustomAsset(png_path),
                frames = meta.frames,
                columns = meta.columns,
                rows = meta.rows,
                frame_size = Vector2.new(meta.fw, meta.fh),
                fps = meta.fps,
            }
        end
    end

    -- download
    local ok, bytes = pcall(function()
        return game:HttpGet(source, true)
    end)
    if not ok or not bytes or #bytes < 6 then
        return nil, 'download failed'
    end

    -- gif?
    local is_gif = bytes:sub(1, 6) == 'GIF87a' or bytes:sub(1, 6) == 'GIF89a'
    if not is_gif then
        -- static image — just save and return
        writefile(png_path, bytes)
        return { asset = CustomAsset(png_path), static = true }
    end

    -- decode
    local parsed = GP.decode_gif(bytes)
    if not parsed or #parsed.frames == 0 then
        return nil, 'decode failed'
    end

    -- pack
    local sheet = pack_sprite_sheet(parsed)
    if not sheet then return nil, 'pack failed' end

    -- encode PNG
    local png = encode_png(sheet.width, sheet.height, sheet.rgba)
    writefile(png_path, png)

    -- average fps from delays (in 1/100s per spec)
    local total_delay = 0
    for _, f in ipairs(parsed.frames) do total_delay = total_delay + f.delay end
    local avg_delay = total_delay / #parsed.frames
    local fps = math.clamp(100 / avg_delay, 5, 30)

    local meta = {
        frames = sheet.frame_count,
        columns = sheet.columns,
        rows = sheet.rows,
        fw = sheet.frame_w,
        fh = sheet.frame_h,
        fps = fps,
    }
    writefile(meta_path, HttpService:JSONEncode(meta))

    return {
        asset = CustomAsset(png_path),
        frames = sheet.frame_count,
        columns = sheet.columns,
        rows = sheet.rows,
        frame_size = Vector2.new(sheet.frame_w, sheet.frame_h),
        fps = fps,
    }
end

-- ═══════════════════════════════════════════════════════════════
--  Sprite player — attach to an ImageLabel
-- ═══════════════════════════════════════════════════════════════
-- Returns a handle with :stop() method
function GP.play(label, info)
    if not label or not info then return nil end

    if info.static then
        label.Image = info.asset
        label.ImageRectOffset = Vector2.zero
        label.ImageRectSize = Vector2.zero
        return { stop = function() end }
    end

    label.Image = info.asset
    label.ImageRectSize = info.frame_size
    label.ImageRectOffset = Vector2.zero

    local frame_index = 0
    local acc = 0
    local frame_dt = 1 / info.fps
    local running = true

    local conn = RunService.RenderStepped:Connect(function(dt)
        if not running then return end
        acc = acc + dt
        if acc < frame_dt then return end
        acc = acc - frame_dt
        frame_index = (frame_index + 1) % info.frames
        local col = frame_index % info.columns
        local row = math.floor(frame_index / info.columns)
        label.ImageRectOffset = Vector2.new(
            col * info.frame_size.X,
            row * info.frame_size.Y
        )
    end)

    return {
        stop = function()
            running = false
            conn:Disconnect()
        end
    }
end

