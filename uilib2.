    function self:build_interface_tab()
        local saved_tab = self._tab
        self._tab = 9999
        local InterfaceTab = self:create_tab('Interface', 'rbxassetid://94381583400007', 16, Color3.fromRGB(100, 100, 100), Color3.fromRGB(190, 190, 190))
        self._tab = saved_tab + 1

        local Handler = Container.Handler

        local function get_pipeline() return getgenv().gif_pipeline end
        local active_player = nil

        local function set_background_image(source)
            if active_player then
                pcall(function() active_player:stop() end)
                active_player = nil
            end

            local bg = self._background
            if not bg then return end

            if not source or source == '' then
                bg.Image = ''
                bg.Visible = false
                return
            end

            bg.Visible = (Library._config._flags['Background_Image'] == true)
            bg.ImageRectOffset = Vector2.zero
            bg.ImageRectSize = Vector2.zero

            local gif_pipeline = get_pipeline()
            if gif_pipeline then
                task.spawn(function()
                    local info, err = gif_pipeline.process(source)
                    if not info then
                        warn('[Background]', err)
                        Library.SendNotification({
                            title = 'Background',
                            text = 'Failed: '..tostring(err),
                            duration = 4,
                        })
                        return
                    end
                    active_player = gif_pipeline.play(bg, info)
                end)
            else
                bg.Image = resolve_image(source, NAMESPACE..'/Backgrounds')
            end
        end

