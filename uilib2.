--  gif_pipeline.lua — GIF → sprite sheet → PNG → asset
--  Returns: { asset, frames, columns, rows, frame_size, fps }
--  Cache: Xinve/Backgrounds/<hash>.png + .meta.json
-- ═══════════════════════════════════════════════════════════════

